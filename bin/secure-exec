#!/usr/bin/env node
// Node shim: spawn the neighbouring server.py with python3, passing stdio through.
const { spawn } = require("child_process");
const path = require("path");

const server = path.join(__dirname, "..", "server.py");
const child = spawn("python3", [server, ...process.argv.slice(2)], {
  stdio: "inherit",
});

child.on("error", (err) => {
  console.error(`secure-exec: failed to start python3: ${err.message}`);
  process.exit(1);
});

child.on("exit", (code) => process.exit(code ?? 1));
